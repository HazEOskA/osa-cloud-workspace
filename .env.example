# Opcjonalne. Jeśli puste, backend próbuje wykryć Project ID z ADC / środowiska GCP.
GCP_PROJECT_ID=

# Cloud Run v2 wymaga konkretnego regionu przy listowaniu usług.
# Wpisz regiony używane przez Ciebie, rozdzielone przecinkami.
GCP_REGIONS=europe-west1,europe-west4

# Server-side bridge do istniejącego OSA Execution Force RuntimeV2.
# URL jest zwykłym env. Klucz w Cloud Run podpinaj wyłącznie jako Secret Manager secretRef.
OSA_EXECUTION_FORCE_URL=
OSA_EXECUTION_FORCE_API_KEY=
