# Opcjonalne. Jeśli puste, backend próbuje wykryć Project ID z ADC / środowiska GCP.
GCP_PROJECT_ID=

# Cloud Run v2 wymaga konkretnego regionu przy listowaniu usług.
# Wpisz regiony używane przez Ciebie, rozdzielone przecinkami.
GCP_REGIONS=europe-west1,europe-west4

# Google Identity używane przez chronione akcje operatora, w tym /api/agent/query.
GOOGLE_CLIENT_ID=
OSA_ADMIN_EMAIL=

# OSA Cloud Agent Phase 1 — managed Agent Runtime. Brak RESOURCE_ID = NIEPOŁĄCZONE.
OSA_AGENT_PROJECT_ID=
OSA_AGENT_LOCATION=europe-west1
OSA_AGENT_RESOURCE_ID=
OSA_AGENT_MODEL=gemini-3.5-flash
